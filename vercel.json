{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    { "source": "/", "has": [{ "type": "header", "key": "x-vercel-ip-country", "value": "RO" }], "destination": "/ro", "permanent": false }
  ],
  "headers": [
    { "source": "/assets/(.*)-([A-Za-z0-9_-]{8})\\.(js|css)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/assets/(fonts|img)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }] }
  ]
}
